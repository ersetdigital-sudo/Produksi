# Supabase Postgres (gunakan connection string pooler port 6543)
DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase API (untuk foto nota dan foto kain)
NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="samaqu"
